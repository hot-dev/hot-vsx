{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Hot",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#namespaceDeclaration"
		},
		{
			"include": "#metaAnnotations"
		},
		{
			"include": "#typeCoercion"
		},
		{
			"include": "#specialIdentifiers"
		},
		{
			"include": "#mapKeys"
		},
		{
			"include": "#flowModifiers"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#variantAccess"
		},
		{
			"include": "#functionCalls"
		},
		{
			"include": "#namespacePaths"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#spreadOperator"
		},
		{
			"include": "#propertyAccess"
		},
		{
			"include": "#placeholders"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#tripleBacktickTemplates"
		},
		{
			"include": "#stringTemplates"
		},
		{
			"include": "#tripleQuoteStrings"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.hot",
					"match": "//.*$"
				},
				{
					"name": "comment.block.hot",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"namespaceDeclaration": {
			"patterns": [
				{
					"name": "meta.namespace.declaration.hot",
					"match": "(::[a-zA-Z_][a-zA-Z0-9_\\-?!]*(?:::[a-zA-Z_][a-zA-Z0-9_\\-?!]*)*)\\s+(meta\\s+\\[[^\\]]*\\]\\s+|meta\\s+\\{[^}]*\\}\\s+)?(ns)\\b",
					"captures": {
						"1": { "name": "support.class.hot" },
						"2": { "name": "meta.annotation.hot" },
						"3": { "name": "keyword.control.namespace.hot" }
					}
				}
			]
		},
		"typeCoercion": {
			"patterns": [
				{
					"name": "meta.type.coercion.hot",
					"match": "([A-Z][a-zA-Z0-9_\\-?!]*)\\s*(->)\\s*([A-Z][a-zA-Z0-9_\\-?!]*)(?:(\\.)([A-Z][a-zA-Z0-9_\\-?!]*))?",
					"captures": {
						"1": { "name": "entity.name.type.hot" },
						"2": { "name": "keyword.operator.coercion.hot" },
						"3": { "name": "entity.name.type.hot" },
						"4": { "name": "punctuation.accessor.hot" },
						"5": { "name": "entity.name.type.variant.hot" }
					}
				}
			]
		},
		"flowModifiers": {
			"patterns": [
				{
					"name": "keyword.operator.pipe.hot",
					"match": "\\|>"
				},
				{
					"comment": "Flow keywords - the lookarounds prevent matching in identifiers like cond-x or some-match",
					"name": "keyword.control.flow.hot",
					"match": "(?<![\\w\\-$])(?:serial|parallel|cond-all|cond|match-all|match)(?![\\w\\-$])"
				},
				{
					"name": "keyword.operator.branch.hot",
					"match": "=>"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"comment": "`open` after `type` or `enum`: an open enum or an open union of literals. Anywhere else it is a name",
					"match": "(?<![\\w\\-$])(type|enum)(\\s+)(open)(?![\\w\\-$?!])",
					"captures": {
						"1": { "name": "keyword.declaration.hot" },
						"3": { "name": "keyword.declaration.modifier.hot" }
					}
				},
				{
					"comment": "Declaration keywords - the lookarounds prevent matching in identifiers like type-name or some-type",
					"name": "keyword.declaration.hot",
					"match": "(?<![\\w\\-$])(?:type|enum|fn|ns|meta)(?![\\w\\-$])"
				},
				{
					"comment": "Control keywords - the lookarounds prevent matching in identifiers like do-request or some-lazy",
					"name": "keyword.control.hot",
					"match": "(?<![\\w\\-$])(?:lazy|do)(?![\\w\\-$])"
				},
				{
					"comment": "Constraint keyword (Hot 3.0+) - the lookarounds prevent matching in identifiers like some-where or where-to",
					"name": "keyword.other.where.hot",
					"match": "(?<![\\w\\-?!])where(?![\\w\\-?!])"
				}
			]
		},
		"tripleQuoteStrings": {
			"comment": "A block string has no escapes: a backslash is a backslash",
			"name": "string.quoted.triple.hot",
			"begin": "\"\"\"",
			"end": "\"\"\""
		},
		"strings": {
			"name": "string.quoted.double.hot",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.hot",
					"match": "\\\\."
				}
			]
		},
		"numbers": {
			"patterns": [{
				"name": "constant.numeric.hot",
				"match": "-?(?:[0-9]+(?:\\.[0-9]+)?)"
			}]
		},
		"specialIdentifiers": {
			"patterns": [
				{
					"name": "variable.language.special.hot",
					"match": "\\$[a-zA-Z_][a-zA-Z0-9_\\-?!]*"
				}
			]
		},
		"mapKeys": {
			"patterns": [
				{
					"comment": "`name: Type value` at the start of a line binds a name: `limit: Int 3`, `vals: All<Vec> parallel {`. A map entry, a field and a parameter have nothing after the type but a `,` or a `where`",
					"name": "meta.binding.typed.hot",
					"match": "^\\s*([a-zA-Z_][a-zA-Z0-9_\\-?!]*)\\s*(:)(?=\\s*(?:::[\\w:\\-]+/)?[A-Z][a-zA-Z0-9_\\-?!]*(?:<[^\\n]*?>+)?\\??(?:\\s*\\|\\s*(?:::[\\w:\\-]+/)?[A-Z][a-zA-Z0-9_\\-?!]*(?:<[^\\n]*?>+)?\\??)*[ \\t]+(?!where(?![\\w\\-?!]))[^\\s,)\\]}|/])",
					"captures": {
						"1": { "name": "variable.other.readwrite.hot" },
						"2": { "name": "punctuation.separator.annotation.hot" }
					}
				},
				{
					"name": "meta.map-key.hot",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_\\-?!]*)\\s*(:)(?![:=])",
					"captures": {
						"1": { "name": "variable.other.property.hot" },
						"2": { "name": "punctuation.separator.key-value.hot" }
					}
				}
			]
		},
		"placeholders": {
			"patterns": [
				{
					"name": "variable.language.placeholder.hot",
					"match": "%(?:\\d+)?"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "entity.name.type.hot",
					"match": "\\b([A-Z][a-zA-Z0-9_\\-?!]*)\\b"
				},
				{
					"name": "variable.other.readwrite.hot",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_\\-?!]*\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.hot",
					"match": "(?<![\\w\\-$])(?:true|false)(?![\\w\\-$])"
				},
				{
					"name": "constant.language.null.hot",
					"match": "(?<![\\w\\-$])null(?![\\w\\-$])"
				}
			]
		},
		"functionCalls": {
			"patterns": [
				{
					"name": "meta.type.constructor.unqualified.hot",
					"match": "\\b([A-Z][a-zA-Z0-9_\\-?!]*)\\s*\\(",
					"captures": {
						"1": { "name": "entity.name.type.hot" }
					}
				},
				{
					"name": "meta.function-call.hot",
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_\\-?!]*)\\s*\\(",
					"captures": {
						"1": { "name": "entity.name.function.hot" }
					}
				}
			]
		},
		"namespacePaths": {
			"patterns": [
				{
					"comment": "A capitalized name after the slash is a type or constructor",
					"name": "meta.namespace.reference.hot",
					"match": "(::[a-zA-Z_][a-zA-Z0-9_\\-?!]*(?:::[a-zA-Z0-9_\\-?!]+)*)(/[A-Z][a-zA-Z0-9_\\-?!]*)",
					"captures": {
						"1": { "name": "support.class.hot" },
						"2": { "name": "entity.name.type.hot" }
					}
				},
				{
					"name": "meta.namespace.reference.hot",
					"match": "(::[a-zA-Z_][a-zA-Z0-9_\\-?!]*(?:::[a-zA-Z0-9_\\-?!]+)*)(/[a-zA-Z_][a-zA-Z0-9_\\-?!]*)?",
					"captures": {
						"1": { "name": "support.class.hot" },
						"2": { "name": "entity.name.function.hot" }
					}
				}
			]
		},
		"metaAnnotations": {
			"patterns": [
				{
					"name": "meta.annotation.bracket.hot",
					"begin": "(?<![\\w\\-$])meta\\s*\\[",
					"end": "\\]",
					"beginCaptures": {
						"0": { "name": "keyword.declaration.meta.hot" }
					},
					"endCaptures": {
						"0": { "name": "punctuation.definition.annotation.end.hot" }
					},
					"patterns": [
						{
							"include": "#metaAnnotationsContent"
						}
					]
				},
				{
					"name": "meta.annotation.brace.hot",
					"begin": "(?<![\\w\\-$])meta\\s*\\{",
					"end": "\\}",
					"beginCaptures": {
						"0": { "name": "keyword.declaration.meta.hot" }
					},
					"endCaptures": {
						"0": { "name": "punctuation.definition.annotation.end.hot" }
					},
					"patterns": [
						{
							"include": "#metaAnnotationsContent"
						}
					]
				}
			]
		},
		"metaBraces": {
			"begin": "\\{",
			"end": "\\}",
			"patterns": [
				{
					"include": "#metaAnnotationsContent"
				}
			]
		},
		"metaBrackets": {
			"begin": "\\[",
			"end": "\\]",
			"patterns": [
				{
					"include": "#metaAnnotationsContent"
				}
			]
		},
		"metaAnnotationsContent": {
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#metaBraces"
				},
				{
					"include": "#metaBrackets"
				},
				{
					"include": "#tripleBacktickTemplates"
				},
				{
					"include": "#stringTemplates"
				},
				{
					"include": "#namespacePaths"
				},
				{
					"include": "#mapKeys"
				},
				{
					"name": "string.quoted.triple.meta.hot",
					"begin": "\"\"\"",
					"end": "\"\"\"",
					"patterns": []
				},
				{
					"name": "string.quoted.double.meta.hot",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.meta.hot",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "constant.numeric.meta.hot",
					"match": "-?(?:[0-9]+(?:\\.[0-9]+)?)"
				},
				{
					"name": "constant.language.boolean.meta.hot",
					"match": "(?<![\\w\\-$])(?:true|false)(?![\\w\\-$])"
				},
				{
					"name": "constant.language.null.meta.hot",
					"match": "(?<![\\w\\-$])null(?![\\w\\-$])"
				},
				{
					"name": "punctuation.separator.meta.hot",
					"match": "[,:]"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.reference.hot",
					"match": "&"
				},
				{
					"name": "keyword.operator.optional.hot",
					"match": "\\?"
				},
				{
					"comment": "Union type operator (e.g., Int | Str, or | Up | Down for variants)",
					"name": "keyword.operator.union.hot",
					"match": "\\|(?!>)"
				}
			]
		},
		"spreadOperator": {
			"patterns": [
				{
					"name": "keyword.operator.spread.hot",
					"match": "\\.\\.\\."
				}
			]
		},
		"propertyAccess": {
			"patterns": [
				{
					"name": "meta.property.access.hot",
					"match": "(?<=[a-zA-Z0-9_?!\\]\\)%])(\\.)([a-zA-Z_][a-zA-Z0-9_\\-?!]*)",
					"captures": {
						"1": { "name": "punctuation.accessor.dot.hot" },
						"2": { "name": "variable.other.property.hot" }
					}
				}
			]
		},
		"variantAccess": {
			"patterns": [
				{
					"comment": "Type.Variant syntax for variant access (e.g., Direction.Up, Result.Ok)",
					"name": "meta.variant.access.hot",
					"match": "\\b([A-Z][a-zA-Z0-9_\\-?!]*)(\\.([A-Z][a-zA-Z0-9_\\-?!]*))\\b",
					"captures": {
						"1": { "name": "entity.name.type.hot" },
						"2": { "name": "punctuation.accessor.hot" },
						"3": { "name": "entity.name.type.variant.hot" }
					}
				}
			]
		},
		"templateExpression": {
			"name": "meta.embedded.expression.hot",
			"begin": "\\$\\{",
			"end": "\\}",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.template-expression.begin.hot" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.definition.template-expression.end.hot" }
			},
			"patterns": [
				{
					"include": "#embeddedCode"
				}
			]
		},
		"embeddedBraces": {
			"begin": "\\{",
			"end": "\\}",
			"patterns": [
				{
					"include": "#embeddedCode"
				}
			]
		},
		"embeddedCode": {
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#specialIdentifiers"
				},
				{
					"include": "#mapKeys"
				},
				{
					"include": "#flowModifiers"
				},
				{
					"include": "#keywords"
				},
				{
					"include": "#variantAccess"
				},
				{
					"include": "#functionCalls"
				},
				{
					"include": "#namespacePaths"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#spreadOperator"
				},
				{
					"include": "#propertyAccess"
				},
				{
					"include": "#placeholders"
				},
				{
					"include": "#constants"
				},
				{
					"include": "#variables"
				},
				{
					"include": "#tripleBacktickTemplates"
				},
				{
					"include": "#stringTemplates"
				},
				{
					"include": "#tripleQuoteStrings"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#numbers"
				},
				{
					"include": "#embeddedBraces"
				}
			]
		},
		"tripleBacktickTemplates": {
			"comment": "A block template has no escapes, so `\\${x}` is a backslash and an expression",
			"name": "string.template.triple.hot",
			"begin": "```",
			"end": "```",
			"patterns": [
				{
					"include": "#templateExpression"
				}
			]
		},
		"stringTemplates": {
			"name": "string.template.hot",
			"begin": "`",
			"end": "`",
			"patterns": [
				{
					"include": "#templateExpression"
				},
				{
					"name": "constant.character.escape.hot",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.hot"
}
